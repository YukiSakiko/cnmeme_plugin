{
  "manifest_version": 2,
  "id": "YukiSakiko.cnmeme-plugin",
  "version": "0.1.2",
  "name": "麦麦梗百科插件",
  "description": "唯独你没懂——按需查询网络梗和陌生词，为麦麦理解聊天提供内部参考，不主动发送词义解释。",
  "author": {
    "name": "YukiSakiko",
    "url": "https://github.com/YukiSakiko"
  },
  "license": "MIT",
  "urls": {
    "repository": "https://github.com/YukiSakiko/cnmeme_plugin"
  },
  "host_application": {
    "min_version": "1.3.16",
    "max_version": "1.3.99"
  },
  "sdk": {
    "min_version": "2.16.0",
    "max_version": "2.99.99"
  },
  "dependencies": [
    {"type": "python_package", "name": "aiohttp", "version_spec": ">=3.8.0"},
    {"type": "python_package", "name": "pydantic", "version_spec": ">=2.0.0,<3.0.0"}
  ],
  "capabilities": ["database.get", "database.save"],
  "i18n": {
    "default_locale": "zh-CN",
    "supported_locales": ["zh-CN"]
  }
}
